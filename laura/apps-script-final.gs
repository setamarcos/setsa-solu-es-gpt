// ========== CONFIGURA\u00c7\u00c3O ==========\nconst SPREADSHEET_ID = "1FcAdi48e9TN8ZAgXDvwH-1PleXgrwSDlggxG_Q74zdk"; // Seu ID aqui\nconst SHEET_NAME = "CLIENTES";\n\n// ========== API ENDPOINTS ==========\nfunction doGet() {\n  return HtmlService.createHtmlOutput(\"API Laura ativa ✅\");\n}\n\nfunction doPost(e) {\n  try {\n    const dados = JSON.parse(e.postData.contents);\n    \n    Logger.log(\"Dados recebidos: \" + JSON.stringify(dados));\n    \n    // Abrir planilha\n    const planilha = SpreadsheetApp.openById(SPREADSHEET_ID);\n    const aba = planilha.getSheetByName(SHEET_NAME);\n    \n    if (!aba) {\n      throw new Error(\"Aba \" + SHEET_NAME + \" n\u00e3o encontrada\");\n    }\n    \n    // Data e hora\n    const data = Utilities.formatDate(new Date(), \"GMT-3\", \"dd/MM/yyyy\");\n    const hora = Utilities.formatDate(new Date(), \"GMT-3\", \"HH:mm:ss\");\n    \n    // Adicionar linha\n    aba.appendRow([\n      data,\n      dados.titulo || \"\",\n      dados.palavras || 0,\n      dados.frases || 0,\n      dados.parafos || 0,\n      dados.erros || 0,\n      dados.nota || 0,\n      dados.avaliacao || \"\",\n      dados.comentario || \"\",\n      dados.resumo || \"\"\n    ]);\n    \n    // Enviar email\n    if (dados.email) {\n      MailApp.sendEmail(\n        dados.email,\n        \"✅ Sua reda\u00e7\u00e3o foi salva - Laura Mentoria\",\n        \"T\u00edtulo: \" + dados.titulo + \"\\nPalavras: \" + dados.palavras + \"\\nNota: \" + dados.nota + \"/100\\nData: \" + data + \"\\n\\nAcesse: https://www.setasolucoes.com.br/laura/\"\n      );\n      \n      // Compartilhar planilha com usu\u00e1rio\n      planilha.addEditor(dados.email);\n    }\n    \n    return ContentService\n      .createTextOutput(JSON.stringify({\n        status: \"success\",\n        mensagem: \"Reda\u00e7\u00e3o salva com sucesso!\",\n        timestamp: new Date().toISOString()\n      }))\n      .setMimeType(ContentService.MimeType.JSON);\n    \n  } catch (erro) {\n    Logger.log(\"Erro: \" + erro.toString());\n    return ContentService\n      .createTextOutput(JSON.stringify({\n        status: \"error\",\n        mensagem: erro.toString()\n      }))\n      .setMimeType(ContentService.MimeType.JSON);\n  }\n}\n\n// ========== FUN\u00c7\u00d5ES AUXILIARES ==========\n\nfunction salvarPDFNoDrive(email, nomeArquivo, conteudo) {\n  try {\n    // Criar arquivo PDF\n    const blob = Utilities.newBlob(conteudo, \"application/pdf\", nomeArquivo + \".pdf\");\n    \n    // Criar pasta se n\u00e3o existir\n    let pasta;\n    const pastas = DriveApp.getFoldersByName(\"Laura Reda\u00e7\u00f5es\");\n    \n    if (pastas.hasNext()) {\n      pasta = pastas.next();\n    } else {\n      pasta = DriveApp.createFolder(\"Laura Reda\u00e7\u00f5es\");\n    }\n    \n    // Criar subpasta do usu\u00e1rio\n    const nomeSubpasta = email.split(\"@\")[0];\n    let subpasta;\n    const subpastas = pasta.getFoldersByName(nomeSubpasta);\n    \n    if (subpastas.hasNext()) {\n      subpasta = subpastas.next();\n    } else {\n      subpasta = pasta.createFolder(nomeSubpasta);\n    }\n    \n    // Salvar arquivo\n    const arquivo = subpasta.createFile(blob);\n    arquivo.addEditor(email);\n    \n    return arquivo.getUrl();\n  } catch (erro) {\n    Logger.log(\"Erro ao salvar PDF: \" + erro);\n    return null;\n  }\n}\n\nfunction salvarXLSNoDrive(email, dados) {\n  try {\n    // Criar novo Sheets\n    const ss = SpreadsheetApp.create(\"Redacao_\" + dados.titulo.replace(/[^a-zA-Z0-9]/g, \"_\"));\n    const sheet = ss.getActiveSheet();\n    \n    // Headers\n    sheet.appendRow([\n      \"Data\",\n      \"T\u00edtulo\",\n      \"Palavras\",\n      \"Frases\",\n      \"Par\u00e1grafos\",\n      \"Erros\",\n      \"Nota\",\n      \"Avalia\u00e7\u00e3o\",\n      \"Coment\u00e1rio\",\n      \"Resumo\"\n    ]);\n    \n    // Dados\n    sheet.appendRow([\n      new Date().toLocaleDateString(\"pt-BR\"),\n      dados.titulo,\n      dados.palavras,\n      dados.frases,\n      dados.parafos,\n      dados.erros,\n      dados.nota,\n      dados.avaliacao,\n      dados.comentario,\n      dados.resumo\n    ]);\n    \n    // Formatar\n    sheet.autoResizeColumns(1, 10);\n    \n    // Criar pasta e mover arquivo\n    let pastaRaiz;\n    const pastas = DriveApp.getFoldersByName(\"Laura Reda\u00e7\u00f5es\");\n    if (pastas.hasNext()) {\n      pastaRaiz = pastas.next();\n    } else {\n      pastaRaiz = DriveApp.createFolder(\"Laura Reda\u00e7\u00f5es\");\n    }\n    \n    const nomeSubpasta = email.split(\"@\")[0];\n    let subpasta;\n    const subpastas = pastaRaiz.getFoldersByName(nomeSubpasta);\n    if (subpastas.hasNext()) {\n      subpasta = subpastas.next();\n    } else {\n      subpasta = pastaRaiz.createFolder(nomeSubpasta);\n    }\n    \n    // Mover arquivo para subpasta\n    const arquivo = DriveApp.getFileById(ss.getId());\n    subpasta.addFile(arquivo);\n    DriveApp.getRootFolder().removeFile(arquivo);\n    \n    // Compartilhar com usu\u00e1rio\n    arquivo.addEditor(email);\n    \n    return arquivo.getUrl();\n  } catch (erro) {\n    Logger.log(\"Erro ao salvar XLS: \" + erro);\n    return null;\n  }\n}\n\nfunction lerRedacoesUsuario(email) {\n  try {\n    const pastaRaiz = DriveApp.getFoldersByName(\"Laura Reda\u00e7\u00f5es\").next();\n    const nomeSubpasta = email.split(\"@\")[0];\n    const subpasta = pastaRaiz.getFoldersByName(nomeSubpasta).next();\n    \n    const arquivos = subpasta.getFiles();\n    const redacoes = [];\n    \n    while (arquivos.hasNext()) {\n      const arquivo = arquivos.next();\n      redacoes.push({\n        nome: arquivo.getName(),\n        url: arquivo.getUrl(),\n        data: arquivo.getDateCreated()\n      });\n    }\n    \n    return redacoes;\n  } catch (erro) {\n    return [];\n  }\n}\n